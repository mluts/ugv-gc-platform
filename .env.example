# Environment for the `sim` Compose profile.
# Copy to `.env` (`cp .env.example .env`) before `make up`.

# Read by: mediamtx (WebRTC ICE advertisement).
# Default 127.0.0.1 keeps playback on this machine only.
# Change to the Mac's LAN address to view the stream from another device on the same Wi-Fi.
LAN_IP=127.0.0.1

# Read by: sim-camera (ffmpeg input).
# Empty = synthetic testsrc2 pattern. Path = loop that file (bind-mounted read-only); missing file is a fatal error.
SIM_CAMERA_SOURCE=

# Read by: sim-camera (ffmpeg output geometry).
# Default 1920x1080. Lower it if encoding overloads the host, or to mimic a Pi sub-stream.
SIM_CAMERA_SIZE=1920x1080

# Read by: sim-camera (ffmpeg output frame rate).
# Default 15. Lower it if encoding overloads the host, or to mimic a Pi sub-stream.
SIM_CAMERA_FPS=15
